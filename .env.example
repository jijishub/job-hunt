# ==========================================
# JOB HUNT & LEADS HUB - ENVIRONMENT TEMPLATE
# Copy to .env.local for local development
# or set directly in Vercel Project Settings
# ==========================================

# 1. Administrator Email (Grants you 👑 Admin role, Notion sync & Portfolio leads)
ADMIN_EMAIL=jizellecasia@gmail.com

# 2. Notion 2-Way Live Sync (Admin only)
NOTION_API_KEY=YOUR_NOTION_API_KEY
NOTION_DATABASE_ID=your_32_character_notion_database_id

# 3. NextAuth Authentication
NEXTAUTH_SECRET=your_random_32_char_secret_here
NEXTAUTH_URL=https://jobhunt.jizellecasia.site

# 4. Google OAuth SSO (Google Cloud Console)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret

# 5. AI Resume & ATS Analyzer
AI_BASE_URL=https://api.jizellecasia.site/v1
AI_API_KEY=your_proxy_api_key_here
AI_DEFAULT_MODEL=luna

# 6. Database (Optional for local development; required for Neon/Postgres production)
# POSTGRES_URL=postgres://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# 7. Optional private RPA profile (server-side JSON; never use NEXT_PUBLIC_)
# Local fallback: references/rpa/bytedance-profile.json (ignored by Git)
# RPA_PROFILE_JSON=
# Optional CLI override for references/rpa/bossjob-profile.json
# BOSSJOB_PROFILE_JSON=
